{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host - Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FC_PLATFORM": "host",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "host-release",
      "displayName": "Host - Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FC_PLATFORM": "host",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "f746-debug",
      "displayName": "NUCLEO-F746ZG - Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/f746-debug",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FC_PLATFORM": "f746",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "f746-release",
      "displayName": "NUCLEO-F746ZG - Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/f746-release",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FC_PLATFORM": "f746",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "h755-debug",
      "displayName": "NUCLEO-H755ZI-Q - Debug (CM7 + CM4)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/h755-debug",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FC_PLATFORM": "h755",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "h755-release",
      "displayName": "NUCLEO-H755ZI-Q - Release (CM7 + CM4)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/h755-release",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FC_PLATFORM": "h755",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug-build",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-release-build",
      "configurePreset": "host-release"
    },
    {
      "name": "f746-debug-build",
      "configurePreset": "f746-debug"
    },
    {
      "name": "f746-release-build",
      "configurePreset": "f746-release"
    },
    {
      "name": "h755-debug-build",
      "configurePreset": "h755-debug"
    },
    {
      "name": "h755-release-build",
      "configurePreset": "h755-release"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug-test",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-release-test",
      "configurePreset": "host-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
