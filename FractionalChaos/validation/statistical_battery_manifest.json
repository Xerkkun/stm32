      "build_command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File validation/build_testu01_ucrt64.ps1 -SourceRoot <TestU01-2009> -OutputDir <empty-output-dir>",
      "file_batteries": [
        "bbattery_RabbitFile",
        "bbattery_AlphabitFile"
      ],
      "note": "The adapter passes the exact requested nb, rejects nb larger than the finite file, and never extends the input. TestU01 may internally use the largest whole 32-bit prefix and rewinds the same file between distinct tests."
    }
  },
